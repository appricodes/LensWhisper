# Defense in depth: these files are only ever meant to be `require`d by other PHP scripts, never
# hit directly over HTTP. If PHP execution is ever misconfigured/disabled for any reason, this
# stops their raw source (DB password, API keys) from being served as plaintext instead.
# NOTE: this only takes effect on Apache. If the server is nginx (check with your host), add the
# equivalent `location ~ ^/(config(\.production)?\.php|modir\.php)$ { deny all; }` to the site's
# nginx config instead — .htaccess files are silently ignored by nginx.
<FilesMatch "^(config(\.production)?\.php|modir\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
