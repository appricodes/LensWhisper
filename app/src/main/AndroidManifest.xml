<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- LiteRT's own manifest asks for these, only for its AI-pack model delivery, which this app
         doesn't use (and whose Play dependency is excluded in app/build.gradle.kts). The app runs
         no foreground service: big downloads go through the system DownloadManager instead (see
         service/SystemDownloads.kt), so neither permission — nor Play's foreground-service
         declaration that comes with them — is needed. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" tools:node="remove" />

    <!-- LocalServerDiscovery: reading the phone's own LAN IP/subnet to probe for a Local Server
         (see network/LocalServerDiscovery.kt). Both are normal-level, no runtime prompt. Kept
         while that feature is switched off (see network/LocalServerFeature.kt) so re-enabling it
         is a one-line change; drop both if it is ever removed for good. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Settings > Your Data > Export writes the .fdb file into the device's public Downloads
         folder. On Android 10+ that goes through MediaStore and needs no permission at all, which
         is why this is capped at API 28: on Android 8/9 the same write is a real file write and
         does. Requested at runtime only on those two versions, only at the moment of an export the
         user asked for — see data/DataTransferManager.kt. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <!-- Lets SpeechOutput list the installed text-to-speech engines (Android 11+ package visibility). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".LensWhisperApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LensWhisper">

        <!-- LiteRT-LM GPU backend for on-device model inference -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libvndksupport.so" android:required="false" />

        <!-- ML Kit ships unbundled (play-services-mlkit-*, see app/build.gradle.kts): this asks
             Play Services to fetch the Latin OCR, barcode and image-labeling modules around install
             time, so the common case never hits the "not ready yet" path. Other OCR scripts are
             requested when chosen in Settings. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr,barcode,ica" />

        <activity
            android:name=".CameraActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.LensWhisper"
            android:configChanges="orientation|keyboardHidden|screenSize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MediaDescriberActivity"
            android:exported="true"
            android:label="Lens Whisper Media Player"
            android:theme="@style/Theme.LensWhisper"
            android:configChanges="orientation|keyboardHidden|screenSize">

            <intent-filter android:label="Lens Whisper Media Player">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:mimeType="video/*" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <!-- No file:// filter: since Android 7 other apps can't hand out file:// Uris at all
                 (FileUriExposedException), and this app holds no storage permission to read one
                 if they did. -->
        </activity>

        <activity
            android:name=".SegmentationExploreActivity"
            android:exported="false"
            android:label="Explore"
            android:theme="@style/Theme.LensWhisper" />

        <activity
            android:name=".ReadDocumentActivity"
            android:exported="false"
            android:label="Read Document"
            android:theme="@style/Theme.LensWhisper" />

        <activity
            android:name=".BarcodeScanActivity"
            android:exported="false"
            android:label="Scan Barcode"
            android:theme="@style/Theme.LensWhisper" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Settings"
            android:theme="@style/Theme.LensWhisper" />

        <activity
            android:name=".LegalActivity"
            android:exported="false"
            android:label="Legal Information"
            android:theme="@style/Theme.LensWhisper" />

        <activity
            android:name=".HelpActivity"
            android:exported="false"
            android:label="Help"
            android:theme="@style/Theme.LensWhisper" />

        <activity
            android:name=".ModelManagementActivity"
            android:exported="false"
            android:label="Manage Advanced Models"
            android:theme="@style/Theme.LensWhisper" />

        <!-- Finishes model / product-database downloads that the system DownloadManager completed
             while the app was closed. See service/SystemDownloads.kt. Exported because the
             broadcast comes from the system's download provider; it only triggers a status
             re-check, so a spoofed one does nothing. -->
        <receiver
            android:name=".service.DownloadCompleteReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>

        <receiver android:name="androidx.media.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Backs sharing a captured photo from Explore/Read Document (see utils/ShareUtils.kt) -
             a plain file:// Uri for a cache-dir file is rejected by other apps on modern Android. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
