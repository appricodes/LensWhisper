<?xml version="1.0" encoding="utf-8"?>
<!--
   Android Auto Backup rules for API 30 and below (API 31+ uses data_extraction_rules.xml
   instead — keep the two in step).

   Include-only: settings (SharedPreferences) and nothing else.

   The app's barcode notes must stay out. They are the user's own written and spoken notes about
   the things around them, kept in app-private storage precisely so that nothing else can read
   them, and the Privacy Policy (legal/LegalTexts.kt) tells the user they stay on the device
   unless the user exports them. Auto Backup would quietly copy them to the user's Google account,
   which is neither what that text describes nor what the user asked for: the one and only
   supported way to move these notes off the phone is Settings > Your Data > Export, which writes
   a file to the Downloads folder, says what it is doing, and waits to be told to go ahead.

   Downloaded model files and the offline product database (filesDir) must stay out too: they are
   far over Auto Backup's 25 MB quota, which would make the whole backup fail, and are
   re-downloadable anyway.
-->
<full-backup-content>
    <include domain="sharedpref" path="." />
</full-backup-content>
