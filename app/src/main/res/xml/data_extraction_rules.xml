<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup/transfer rules for API 31 and above. The API 30-and-below equivalent is
   backup_rules.xml — keep the two in step.

   Include-only: settings (SharedPreferences) and nothing else. Listing an <include> excludes
   every other domain, which is what keeps out:
   - the barcode notes (barcode_notes.db and filesDir/barcode_notes/), for the reason spelled out
     in backup_rules.xml — that also holds for device-to-device transfer, so the statement "the
     only way these notes move is Export to Downloads and Import from Downloads" is true without
     exceptions;
   - downloaded AI models and the offline product database in filesDir — gigabytes, far over
     Auto Backup's 25 MB quota (going over it makes the WHOLE backup fail, settings included), and
     re-downloadable anyway.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
