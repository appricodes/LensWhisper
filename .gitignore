local.properties

# Secrets - contain live DB/API credentials and admin password, never commit
config.php
backend/config.php
backend/config.production.php
modir.php
backend/modir.php
/Credentials/

# Local test photos for the desktop CLI - keep out of the repo
desktop/test_images/

# Backup copies of segmentation model files no longer bundled in the app (kept locally in case a
# dropped size/precision is ever wanted back - see app/src/main/assets/models/)
/model_backups/

# Candidate UI-sound WAV previews (and the scripts that generate them) for auditioning before one
# gets ported into ProcessingSoundPlayer.kt's synthesis code - never shipped, never meant to be
# committed, delete once a choice is made
/sound_previews/

# Downloaded bulk product dumps and generated lookup DBs for the barcode DB builder - large
# binary artifacts, regenerate with tools/barcode_db/build_barcode_db.py instead of committing
tools/barcode_db/cache/
tools/barcode_db/*.db
tools/barcode_db/*.db.gz
tools/barcode_db/*.db.sha256
tools/barcode_db/*.sqlite3
tools/barcode_db/*.sqlite3-wal
tools/barcode_db/*.sqlite3-shm
tools/barcode_db/__pycache__/

# Release signing: upload-keystore passwords/paths and the keystores themselves.
/keystore.properties
*.jks
*.keystore

# The export/import passphrase (see secrets.properties.example, which IS committed as its
# placeholder, and app/build.gradle.kts, which reads this into BuildConfig.BACKUP_PASSPHRASE).
/secrets.properties

# Generated upload bundle for the app's product-database catalog (compressed copies of the
# .sqlite3 files above plus catalog.json) - regenerate with publish_barcode_db.py
tools/barcode_db/publish/
